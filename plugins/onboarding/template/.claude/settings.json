{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "beep-beginners": {
      "source": { "source": "github", "repo": "kriegcloud/beep-beginners" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "guards@beep-beginners": true,
    "explore@beep-beginners": true,
    "unslop@beep-beginners": true,
    "helper@beep-beginners": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "env": {
    "BEEP_BEGINNERS_MODE": "operator"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)", "PowerShell(git status:*)",
      "Bash(git add:*)", "PowerShell(git add:*)",
      "Bash(git commit:*)", "PowerShell(git commit:*)",
      "Bash(git push)", "PowerShell(git push)",
      "Bash(git push origin:*)", "PowerShell(git push origin:*)",
      "Bash(git pull:*)", "PowerShell(git pull:*)",
      "Bash(git log:*)", "PowerShell(git log:*)",
      "Bash(git diff:*)", "PowerShell(git diff:*)",
      "Bash(git mv:*)", "PowerShell(git mv:*)",
      "Bash(gh:*)", "PowerShell(gh:*)",
      "Bash(uv:*)", "PowerShell(uv:*)",
      "Bash(winget list:*)", "PowerShell(winget list:*)",
      "Bash(winget install:*)", "PowerShell(winget install:*)",
      "Bash(op run:*)", "PowerShell(op run:*)",
      "Bash(op whoami:*)", "PowerShell(op whoami:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "PowerShell(git push --force:*)",
      "Bash(git push -f:*)", "PowerShell(git push -f:*)",
      "Bash(git push --force-with-lease:*)", "PowerShell(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)", "PowerShell(git reset --hard:*)",
      "Bash(git clean -f:*)", "PowerShell(git clean -f:*)",
      "Bash(git clean -fd:*)", "PowerShell(git clean -fd:*)",
      "Bash(git branch -D:*)", "PowerShell(git branch -D:*)",
      "Bash(git checkout .:*)", "PowerShell(git checkout .:*)",
      "Bash(git restore .:*)", "PowerShell(git restore .:*)",
      "Bash(rm -rf /:*)", "Bash(rm -rf ~:*)",
      "PowerShell(Remove-Item C:\\:*)", "PowerShell(Remove-Item $HOME:*)",
      "Read(**/.env)", "Read(**/.env.local)", "Read(**/*.pem)", "Read(**/*.key)",
      "Read(**/.ssh/**)", "Read(**/secrets/**)", "Read(**/bitwarden_export*)",
      "Edit(**/.env)", "Edit(**/.ssh/**)", "Edit(**/secrets/**)"
    ]
  }
}
