{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "beep-beginners": {
      "source": {
        "source": "github",
        "repo": "kriegcloud/beep-beginners"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "guards@beep-beginners": true,
    "unslop@beep-beginners": true,
    "helper@beep-beginners": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "env": {
    "BEEP_BEGINNERS_MODE": "mentor"
  },
  "model": "claude-opus-5-5",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  }
}
