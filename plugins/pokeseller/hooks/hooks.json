{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--script", "${CLAUDE_PLUGIN_ROOT}/hooks/listing_check.py"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
