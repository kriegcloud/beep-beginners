{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "extraKnownMarketplaces": {
    "beep-beginners": {
      "source": {
        "source": "github",
        "repo": "kriegcloud/beep-beginners",
        "ref": "stable"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "kit@beep-beginners": true,
    "unslop@beep-beginners": true,
    "helper@beep-beginners": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "env": {
    "BEEP_BEGINNERS_MODE": "operator"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "PowerShell(git status:*)",
      "Bash(git log:*)",
      "PowerShell(git log:*)",
      "Bash(git diff:*)",
      "PowerShell(git diff:*)",
      "Bash(git mv:*)",
      "PowerShell(git mv:*)",
      "Bash(git fetch:*)",
      "PowerShell(git fetch:*)",
      "Bash(git pull:*)",
      "PowerShell(git pull:*)",
      "Bash(git push)",
      "PowerShell(git push)",
      "Bash(git push origin:*)",
      "PowerShell(git push origin:*)",
      "Bash(git worktree:*)",
      "PowerShell(git worktree:*)",
      "Bash(gh api:*)",
      "PowerShell(gh api:*)",
      "Bash(gh auth status:*)",
      "PowerShell(gh auth status:*)",
      "Bash(uv:*)",
      "PowerShell(uv:*)",
      "Bash(bun:*)",
      "PowerShell(bun:*)",
      "Bash(gitleaks:*)",
      "PowerShell(gitleaks:*)",
      "Bash(winget list:*)",
      "PowerShell(winget list:*)",
      "Bash(winget install:*)",
      "PowerShell(winget install:*)",
      "Bash(op run:*)",
      "PowerShell(op run:*)",
      "Bash(op whoami:*)",
      "PowerShell(op whoami:*)",
      "Bash(op vault list:*)",
      "PowerShell(op vault list:*)"
    ],
    "deny": [
      "Bash(git add:*)",
      "PowerShell(git add:*)",
      "Bash(git commit:*)",
      "PowerShell(git commit:*)",
      "Bash(git merge:*)",
      "PowerShell(git merge:*)",
      "Bash(git push --force:*)",
      "PowerShell(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "PowerShell(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "PowerShell(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "PowerShell(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "PowerShell(git clean -fd:*)",
      "Bash(git branch -D:*)",
      "PowerShell(git branch -D:*)",
      "Bash(git checkout .:*)",
      "PowerShell(git checkout .:*)",
      "Bash(git restore .:*)",
      "PowerShell(git restore .:*)",
      "Bash(gh pr merge:*)",
      "PowerShell(gh pr merge:*)",
      "Bash(gh pr:*)",
      "PowerShell(gh pr:*)",
      "Bash(gh api * merge*)",
      "PowerShell(gh api * merge*)",
      "Bash(gh api *merges*)",
      "PowerShell(gh api *merges*)",
      "Bash(git push --force-if-includes:*)",
      "PowerShell(git push --force-if-includes:*)",
      "Bash(git push --delete:*)",
      "PowerShell(git push --delete:*)",
      "Bash(git push -d:*)",
      "PowerShell(git push -d:*)",
      "Bash(git push --prune:*)",
      "PowerShell(git push --prune:*)",
      "Bash(git push --mirror:*)",
      "PowerShell(git push --mirror:*)",
      "Bash(git push origin :*)",
      "PowerShell(git push origin :*)",
      "Bash(git push origin +*)",
      "PowerShell(git push origin +*)",
      "Bash(git branch -d main*)",
      "PowerShell(git branch -d main*)",
      "Bash(git branch -d goal/*)",
      "PowerShell(git branch -d goal/*)",
      "Bash(git branch -d project/*)",
      "PowerShell(git branch -d project/*)",
      "Bash(git branch -d claude/*)",
      "PowerShell(git branch -d claude/*)",
      "Bash(git branch --delete:*)",
      "PowerShell(git branch --delete:*)",
      "Bash(git branch -m main*)",
      "PowerShell(git branch -m main*)",
      "Bash(git branch -M main*)",
      "PowerShell(git branch -M main*)",
      "Bash(git tag -d:*)",
      "PowerShell(git tag -d:*)",
      "Bash(git tag --delete:*)",
      "PowerShell(git tag --delete:*)",
      "Bash(git update-ref -d:*)",
      "PowerShell(git update-ref -d:*)",
      "Bash(gh repo delete:*)",
      "PowerShell(gh repo delete:*)",
      "Bash(gh repo archive:*)",
      "PowerShell(gh repo archive:*)",
      "Bash(gh repo rename:*)",
      "PowerShell(gh repo rename:*)",
      "Bash(gh api -X DELETE:*)",
      "PowerShell(gh api -X DELETE:*)",
      "Bash(gh api --method DELETE:*)",
      "PowerShell(gh api --method DELETE:*)",
      "Bash(gh api -X PATCH repos/*)",
      "PowerShell(gh api -X PATCH repos/*)",
      "Bash(gh api --method PATCH repos/*)",
      "PowerShell(gh api --method PATCH repos/*)",
      "Bash(gh api * rulesets*)",
      "PowerShell(gh api * rulesets*)",
      "Bash(gh api * protection*)",
      "PowerShell(gh api * protection*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "PowerShell(Remove-Item C:\\:*)",
      "PowerShell(Remove-Item $HOME:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.ssh/**)",
      "Read(**/secrets/**)",
      "Read(**/bitwarden_export*)",
      "Edit(**/.env)",
      "Edit(**/.ssh/**)",
      "Edit(**/secrets/**)"
    ]
  }
}
