# Checks for projects/{{name}}. Runs only when that folder changes.
name: project-{{name}}

on:
  push:
    branches: [main]
    paths: ["projects/{{name}}/**", ".github/workflows/project-{{name}}.yml"]
  pull_request:
    paths: ["projects/{{name}}/**", ".github/workflows/project-{{name}}.yml"]

permissions:
  contents: read

jobs:
  test:
    name: tests
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: projects/{{name}}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
      - run: bun install
      - run: bun run check
      - run: bun run typecheck
      - run: bun run test
